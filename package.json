{
  "name": "crypto-trading-bot",
  "version": "1.0.0",
  "description": "Modular DEX crypto trading bot with Smart Money Concepts (SMC) strategy",
  "main": "src/bot.js",
  "bin": {
    "trading-bot": "./src/cli/interface.js"
  },
  "scripts": {
    "start": "node src/bot.js",
