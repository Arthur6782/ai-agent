# Crypto Token Analyzer - Environment Variables
# Copy this to .env and fill in your API keys

# CoinGecko API Key (free tier works, pro for higher limits)
COINGECKO_API_KEY=

# Etherscan API Key (for on-chain analysis on Ethereum)
ETHERSCAN_API_KEY=

# DEXScreener API Key (optional, public endpoints work without key)
DEXSCREENER_API_KEY=
