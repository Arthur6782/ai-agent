# ============================================================
#  CRYPTO TRADING BOT — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit your real .env file to git.

# ─── BOT SETTINGS ────────────────────────────────────────────
# Trading mode: paper (safe simulation) or live (real trades)
BOT_MODE=paper

# How often to scan the market (seconds)
BOT_INTERVAL=30

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# ─── RISK SETTINGS ───────────────────────────────────────────
# Max % of balance to risk per trade (0.02 = 2%)
MAX_RISK_PER_TRADE=0.02

# Paper trading starting balance in USD
PAPER_BALANCE=10000

# ─── FILTERS ─────────────────────────────────────────────────
# Minimum liquidity required in USD (anti-rug protection)
MIN_LIQUIDITY_USD=50000

# ─── WALLET (required for LIVE mode only) ────────────────────
# Solana RPC endpoint (get a free one from helius.dev or quicknode.com)
RPC_URL=https://api.mainnet-beta.solana.com

# Your wallet private key in base58 (Solana) or hex (EVM)
# WARNING: Keep this secret. Never share or commit this value.
WALLET_PRIVATE_KEY=

# ─── EVM (optional, for Ethereum/BSC trading) ────────────────
# EVM RPC URL (e.g., Infura, Alchemy, QuickNode)
# EVM_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
# EVM_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HEX
